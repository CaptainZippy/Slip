; The exposed loop variable aliases an explicit per-iteration copy, not cur.

(macro count_copies (vname limit body) env
    $(let body_env $(make_env env))
    (var cur 0:int)
    (var end $(expand limit env))
    (while (lt? cur end)
        (var copy cur)
        $(bind body_env $(insert vname) copy)
        $(expand body body_env)
        (set! cur (add cur 1))))

(func check (actual:int expected:int):int
    (cond ((eq? actual expected) 0) (true 1)))

(func main ():int
    (var i 77)
    (var cur 88)
    (var end 99)
    (var visits 0)
    (var total 0)
    (count_copies i 4
        (begin
            (set! visits (add visits 1))
            (set! total (add total i))
            ; A mistaken alias to cur still terminates, but fails the checks.
            (set! i 100)))
    (add (check visits 4)
        (add (check total 6)
            (add (check i 77)
                (add (check cur 88) (check end 99))))))
