; Inserted and literal bindings, private locals, shadowing, and nested expansion.

(macro with_value (vname initial body) env
    $(let body_env $(child_env env))
    (var current $(expand initial env))
    $(bind body_env $(insert vname) current)
    $(expand body body_env))

(macro with_literal (body) env
    $(let body_env $(child_env env))
    (var current 42)
    $(bind body_env item current)
    $(expand body body_env))

(func check (actual:int expected:int):int
    (cond ((eq? actual expected) 0) (true 1)))

(func main ():int
    (var i 50)
    (var current 60)
    (var item 70)
    (var observed (with_value i 3
        (begin
            (set! i (add i 1))
            (add i current))))
    (var same_name (with_value current 7 current))
    (var nested (with_value i 1 (add i (with_value i 2 i))))
    (var repeated (with_value j 9 j))
    (var literal (with_literal item))
    (add (check observed 64)
        (add (check i 50)
            (add (check current 60)
                (add (check item 70)
                    (add (check same_name 7)
                        (add (check nested 3)
                            (add (check repeated 9) (check literal 42)))))))))
