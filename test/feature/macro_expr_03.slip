; 
(macro countup (vname limit body) env
    $(let body_env $(make_env env))
    (var cur 0:int)
    (var end $(expand limit body_env))
    (while (lt? cur end)
        (var curcopy cur)
        $(bind body_env $(insert vname) curcopy)
        $(expand body body_env)
        (set! cur (add cur 1)) ))

