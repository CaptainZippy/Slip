;===
; CannotOverload
; Even function handles cannot replace an expansion-time same-scope binding.
(macro duplicate_let () env
    (func value ():int 1)
    $(let target value)
    $(let target value)
    0)

(duplicate_let)

(func main ():int 0)
;===
; CannotOverload
; Bind cannot create an overload group, even for distinct function signatures.
(macro duplicate_bind () env
    $(let target $(make_env env))
    (func first (value:int):int 1)
    (func second (value:double):int 2)
    $(bind target item first)
    $(bind target item second)
    0)

(duplicate_bind)

(func main ():int 0)
